# Server-only local Redis connection for the server-wide open counter.
REDIS_URL=redis://localhost:6379

# Cho phép mở dialog kết quả trực tiếp khi bấm vào card trong danh sách nữ diễn viên (true/false)
NEXT_PUBLIC_DIRECT_CARD_DIALOG=false

# Supabase project cho đăng nhập (magic link) + đồng bộ favorites/tier đa thiết bị.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

